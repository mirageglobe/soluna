---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Converter from '../components/Converter.astro';
import Features from '../components/Features.astro';
import Install from '../components/Install.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="soluna" description="gregorian and chinese lunar calendar conversion for javascript. zero dependencies, one file.">
  <main class="page">
    <ThemeToggle />
    <Hero />
    <Converter />
    <Features />
    <Install />

    <footer>
      soluna is source-available under BUSL-1.1, see
      <a href="https://github.com/mirageglobe/soluna/blob/main/LICENSE.md">LICENSE.md</a>.
      <span id="stamp"></span>
    </footer>
  </main>

  <script is:inline define:vars={{ base }}>
    // build stamp: which source commit and time the live site was built from
    fetch(base + '/version.json')
      .then(function (r) { return r.json(); })
      .then(function (v) {
        document.getElementById('stamp').textContent = 'v' + v.version + ' [ built ' + v.source + ' ' + v.built + ' ]';
      })
      .catch(function () {});
  </script>
</Base>
