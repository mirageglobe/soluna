---
import '../styles/base.css';
import '../styles/site.css';

const { title, description } = Astro.props;

// the library is copied to site/public/soluna.js at build time; load it base-aware
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lib = `${base}/soluna.js`;

// a small crescent as the tab icon, inline so there is no extra file
const icon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><circle cx="16" cy="16" r="14" fill="#5fb39d"/><circle cx="22" cy="12" r="12" fill="#15171a"/></svg>'
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={icon} />
    <script is:inline>
      // dark is the guide default; follow a light system setting
      if (window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
    <script is:inline src={lib}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
