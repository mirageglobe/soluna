<section id="converter">
  <h2 class="section-title">convert</h2>
  <div class="cards">
    <form id="s2l" class="card" onsubmit="return false">
      <h3>gregorian to lunar</h3>
      <div class="row">
        <label>date <input id="s-date" type="date" min="1900-01-31" max="2100-12-31" /></label>
        <label>time <input id="s-time" type="time" value="12:00" /></label>
      </div>
      <div id="s2l-out" class="out" aria-live="polite"></div>
    </form>
    <form id="l2s" class="card" onsubmit="return false">
      <h3>lunar to gregorian</h3>
      <div class="row">
        <label>year <input id="l-year" type="number" min="1900" max="2100" /></label>
        <label>month <input id="l-month" type="number" min="1" max="12" /></label>
        <label>day <input id="l-day" type="number" min="1" max="30" /></label>
        <label><input id="l-leap" type="checkbox" /> leap month</label>
      </div>
      <div id="l2s-out" class="out" aria-live="polite"></div>
    </form>
  </div>
</section>

<script is:inline>
  (function () {
    var S = window.Soluna;
    var s2lOut = document.getElementById('s2l-out');
    var l2sOut = document.getElementById('l2s-out');
    var val = function (id) { return document.getElementById(id).value; };
    var pad = function (n) { return String(n).padStart(2, '0'); };

    // tiny dom helper: textContent only, so nothing from the library is parsed as html
    function el(tag, cls, text) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    }
    function head(date, sub) {
      var h = el('div', 'lunar-head');
      h.appendChild(el('span', 'lunar-date', date));
      h.appendChild(el('span', 'lunar-sub', sub));
      return h;
    }
    function chip(list, key, text) {
      var li = el('li');
      li.appendChild(el('span', 'k', key));
      li.appendChild(document.createTextNode(text));
      list.appendChild(li);
    }
    var fail = function (out, msg) { out.replaceChildren(el('p', 'fail', '[ FAIL ] ' + msg)); };

    function solarToLunar() {
      var d = val('s-date').split('-').map(Number);
      var t = (val('s-time') || '00:00').split(':').map(Number);
      if (d.length < 3 || d.some(isNaN)) return fail(s2lOut, 'enter a date');
      try {
        var r = S.solarToLunar(d[0], d[1], d[2], t[0], t[1], 0);
        var f = r.festivals;
        var l = r.lunar;
        var pillars = el('div', 'pillars');
        [['year', '年', r.baZi.year], ['month', '月', r.baZi.month], ['day', '日', r.baZi.day], ['hour', '时', r.baZi.hour]].forEach(function (p) {
          var b = el('div', 'pillar');
          b.appendChild(el('b', null, p[2].stem + p[2].branch));
          b.appendChild(el('span', null, p[0] + ' ' + p[1]));
          pillars.appendChild(b);
        });
        var chips = el('ul', 'chips');
        chip(chips, 'hour', r.timePeriod ? r.timePeriod.name + ' ' + r.timePeriod.period : '-');
        chip(chips, 'festival', [(f.lunar && f.lunar.name), (f.solar && f.solar.name), (f.sanniangSha && '三娘煞日')].filter(Boolean).join(', ') || '-');
        chip(chips, 'moon', r.moonPhase.nameZh + ' ' + r.moonPhase.name);
        s2lOut.replaceChildren(
          head((l.isLeapMonth ? '闰' : '') + l.monthName + '月 ' + l.dayName, l.year + ' · ' + r.stemBranch.year + '年 · ' + l.zodiac),
          pillars,
          chips
        );
        return r;
      } catch (e) { fail(s2lOut, e.message); }
    }

    function lunarToSolar() {
      var y = +val('l-year'), m = +val('l-month'), d = +val('l-day');
      if (!y || !m || !d) return fail(l2sOut, 'enter year, month and day');
      try {
        var r = S.lunarToSolar(y, m, d, document.getElementById('l-leap').checked, 12, 0, 0);
        if (!r) return fail(l2sOut, 'not a valid lunar date');
        l2sOut.replaceChildren(head(r.solar.year + '-' + pad(r.solar.month) + '-' + pad(r.solar.day), '周' + r.solar.weekDay));
      } catch (e) { fail(l2sOut, 'not a valid lunar date'); }
    }

    // start from today (local), then seed the lunar form from the result
    var now = new Date();
    document.getElementById('s-date').value = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
    var today = solarToLunar();
    if (today) {
      document.getElementById('l-year').value = today.lunar.year;
      document.getElementById('l-month').value = today.lunar.month;
      document.getElementById('l-day').value = today.lunar.day;
      document.getElementById('l-leap').checked = today.lunar.isLeapMonth;
      lunarToSolar();
    }
    document.getElementById('s2l').addEventListener('input', solarToLunar);
    document.getElementById('l2s').addEventListener('input', lunarToSolar);
  })();
</script>

<style>
  .cards { display: flex; flex-direction: column; gap: 16px; }
</style>
