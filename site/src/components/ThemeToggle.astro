<button id="theme-toggle" class="theme-toggle" type="button" aria-label="switch theme">
  <svg class="i-sun" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
    <circle cx="8" cy="8" r="3"></circle>
    <path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1"></path>
  </svg>
  <svg class="i-moon" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
    <path d="M13 9.6A5.5 5.5 0 0 1 6.4 3a5.5 5.5 0 1 0 6.6 6.6z"></path>
  </svg>
  <span id="theme-label"></span>
</button>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    var label = document.getElementById('theme-label');

    // the label names the mode a click switches to
    function paint() {
      var light = root.getAttribute('data-theme') === 'light';
      label.textContent = light ? 'dark' : 'light';
      btn.setAttribute('aria-label', 'switch to ' + (light ? 'dark' : 'light') + ' theme');
    }

    btn.addEventListener('click', function () {
      var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('soluna-theme', next); } catch (e) {} // storage can be blocked; the toggle still works
      paint();
    });
    paint();
  })();
</script>

<style>
  .theme-toggle {
    position: absolute; top: 14px; right: 0; display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--mono); font-size: 0.74rem; color: var(--text-dim); background: var(--surface);
    border: 1px solid var(--border); border-radius: 999px; padding: 5px 12px 5px 10px; cursor: pointer;
  }
  .theme-toggle:hover { color: var(--text); border-color: var(--text-dim); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* dark shows the sun (click for light); light shows the moon (click for dark) */
  .i-moon { display: none; }
  :global(:root[data-theme='light']) .i-sun { display: none; }
  :global(:root[data-theme='light']) .i-moon { display: inline; }
</style>
