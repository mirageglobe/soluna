---
// what the library gives you, from the readme: [glyph, name, detail]
const features = [
  ['阴阳', 'two-way conversion', 'gregorian to lunar and back, leap month aware, 1900 to 2100'],
  ['八字', 'four pillars', 'bazi from the real solar term boundary, not the gregorian month edge'],
  ['时辰', 'time periods', 'the twelve double-hours, with the 子 hour day boundary handled'],
  ['节日', 'festivals', 'public, buddhist, taoist and folk dates, plus 三娘煞日'],
  ['月相', 'moon and solar terms', 'moon phase and solar term returned with every conversion'],
  ['一', 'one file', 'zero dependencies; runs in node.js and in the browser'],
];
---

<section>
  <h2 class="section-title">what it does</h2>
  <ul class="features">
    {features.map(([glyph, name, detail]) => (
      <li>
        <span class="glyph cjk">{glyph}</span>
        <div>
          <strong>{name}</strong>
          <p class="mut">{detail}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .features { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .features li { display: flex; gap: 14px; align-items: flex-start; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; }
  .glyph { font-size: 1.7rem; line-height: 1; color: var(--accent); min-width: 3.6rem; white-space: nowrap; text-align: center; padding-top: 2px; }
  strong { font-weight: 600; font-size: 0.95rem; }
  p { margin-top: 3px; }
</style>
